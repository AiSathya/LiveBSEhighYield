# Server-only, never prefix secrets with VITE_ or commit a populated .env.
# Generate in Upstox Developer Apps > Analytics. Read-only token, valid one year.
UPSTOX_ANALYTICS_TOKEN=

# Set true only after provider/exchange public display/redistribution rights are confirmed.
# Also required for server-side provider calls because /api/bse/snapshot is public.
BSE_PUBLIC_DATA_REDISTRIBUTION_CONFIRMED=false

# Set true only after explicit full TTM history coverage and INR per-share review.
# Quotes and events can be displayed without this; TTM/yield remains null.
UPSTOX_DIVIDEND_HISTORY_CONFIRMED=false

PORT=3000
# NODE_ENV=production
